# 复制为 .env 后按需修改；**不要**把 .env 提交进仓库。
# 说明：compose 里所有值都有演示默认，因此不做任何配置也能起来 —— 但那只适合隔离环境。

# ── 控制台 / 注入接口的安全边界（最重要）────────────────────────────────
# 端口绑定：默认仅本机回环。要跨机访问改成 0.0.0.0（必须同时设 CHAOS_API_TOKEN）
CC_BIND=127.0.0.1
# 注入接口令牌：一旦对外暴露**必须**设置；设置后控制台「故障注入」页要填同一个值
CHAOS_API_TOKEN=
# 一键关掉整个注入控制台（0 = 关闭）
CHAOS_UI_ENABLED=1

# ── Grafana ───────────────────────────────────────────────────────────────
# 注意：该变量只在 **首次初始化** 数据卷时生效；已有环境要用
#   docker exec cc-grafana grafana cli admin reset-admin-password <新口令>
GRAFANA_ADMIN_PASSWORD=cc-ops-grafana

# ── 数据库（演示默认值；生产请全部替换）──────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_USER=appuser
DB_PASSWORD=apppass
DB_NAME=creditcard
# 只读取证账号（诊断工具用它，权限只有 SELECT + PROCESS + REPLICATION CLIENT）
RCA_DB_USER=rca_readonly
RCA_DB_PASSWORD=rca_readonly_pwd

# ── RCA 智能体 ────────────────────────────────────────────────────────────
# 确定性快路径的置信度门槛（低于它就转 LLM Agent）
RCA_FAST_PATH_CONFIDENCE=0.85
# 单次诊断的 token 硬上限（超出即停止后续调用并标记）
RCA_AGENT_MAX_TOKENS=60000
# 关掉"组件级→根因级"升级（用于 A/B 对照）
# RCA_DISABLE_COMPONENT_PROMOTION=1
# 运行时切换 LLM（也可在控制台「模型设置」里改，重启失效）
# RCA_LLM_PROVIDER=agnes
# RCA_LLM_MODEL=agnes-3.0-flash
# RCA_LLM_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_API_KEY=

# ── 应用侧 ────────────────────────────────────────────────────────────────
# txnRows 展示缓存的 TTL（毫秒）；0 = 关闭缓存（每次探针都扫表）
TXN_ROWS_TTL_MS=60000

# ── 工具侧自定地址（在宿主机直接跑 CLI 时用）──────────────────────────────
CHAOS_PROM_URL=http://localhost:9090
CHAOS_APP_LB=http://localhost:8080
CHAOS_RCA_API=http://localhost:8088
CHAOS_CONSOLE_URL=http://localhost:3001
